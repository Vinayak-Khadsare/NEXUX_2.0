# =====================================================================
# NEXUS INTELLIGENCE PLATFORM - ENVIRONMENT EXAMPLE TEMPLATE
# =====================================================================

# Database Configuration
# Docker Compose network:
MONGODB_URI=mongodb://mongodb:27017
# Local host development:
# MONGODB_URI=mongodb://localhost:27017
DATABASE_NAME=nexus
MONGO_PORT=27018

# Security & Authentication (Change in Production)
JWT_SECRET=your_super_secret_jwt_key_here

# Local AI Engine (Ollama & Qwen 2.5)
NEXUS_LOCAL_AI_URL=http://ollama:11434
NEXUS_LOCAL_AI_MODEL=qwen2.5:7b
NEXUS_LOCAL_AI_TIMEOUT=300

# Optional External AI Services
HUGGINGFACE_API_KEY=

# Application & Service URLs
ENVIRONMENT=development
FRONTEND_URL=http://localhost:3000
NEXT_PUBLIC_API_URL=http://localhost:8000
BACKEND_URL=http://backend:8000

# Email & Notification Service (OTP / Password Reset)
EMAIL_SERVICE_URL=http://email-service:3001
EMAIL_SERVICE_API_KEY=
